<h3>
    <div class="alert alert-secondary" role="alert">
        <i class="ti ti-shopping-cart-plus"></i>&nbsp;{{ __('Consumable request', 'consumables') }}
    </div>
</h3>

<div class="row consumables_wizard_row" style="margin: 0 auto;">
    {% if can_request %}
        <div class="center col-md-5 consumables_wizard_rank">
            <a class="consumables_menu_a" href="{{ webdir }}/front/wizard.form.php?action=consumablerequest">
                <i class="thumbnail ti ti-shopping-cart-plus" style="font-size: 4.5em;"></i>
                <br><br>{{ __('Consumable request', 'consumables') }}<br>
            </a>
        </div>
    {% endif %}

    {% if can_validate %}
        <div style="width: 10px;"></div>
        <div class="center col-md-6 consumables_wizard_rank">
            <a class="consumables_menu_a" href="{{ webdir }}/front/wizard.form.php?action=consumablevalidation">
                <i class="thumbnail ti ti-clipboard-check" style="font-size: 4.5em;"></i>
                <br><br>{{ __('Consumable validation', 'consumables') }}
            </a>
        </div>
    {% endif %}
</div>
