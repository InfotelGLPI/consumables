{# Consumables wizard menu (Wizard::showMenu()): one clickable card per entry #}
<div class="container-lg my-3">
    <h2 class="mb-3">
        <i class="ti ti-shopping-cart me-2"></i>{{ _n('Consumable', 'Consumables', 2) }}
    </h2>
    <div class="row row-cards g-3">
        {% if can_request %}
            <div class="col-12 col-sm-6 col-lg-4">
                <a href="{{ webdir }}/front/wizard.form.php?action=consumablerequest"
                   class="card card-link card-link-pop h-100 text-reset text-decoration-none">
                    <div class="card-body text-center py-4">
                        <span class="avatar avatar-xl bg-secondary-lt mb-3">
                            <i class="ti ti-shopping-cart-plus fs-1"></i>
                        </span>
                        <h3 class="card-title mb-0">{{ __('Consumable request', 'consumables') }}</h3>
                    </div>
                </a>
            </div>
        {% endif %}
        {% if can_validate %}
            <div class="col-12 col-sm-6 col-lg-4">
                <a href="{{ webdir }}/front/wizard.form.php?action=consumablevalidation"
                   class="card card-link card-link-pop h-100 text-reset text-decoration-none">
                    <div class="card-body text-center py-4">
                        <span class="avatar avatar-xl bg-secondary-lt mb-3">
                            <i class="ti ti-clipboard-check fs-1"></i>
                        </span>
                        <h3 class="card-title mb-0">{{ __('Consumable validation', 'consumables') }}</h3>
                    </div>
                </a>
            </div>
        {% endif %}
    </div>
</div>
