{# Request history of a consumable item (Request::showForConsumable()) #}
{% import '@consumables/macros.html.twig' as consumables %}

<div class="card mb-3">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title">
            <i class="ti ti-history me-2"></i>{{ rows is not empty ? __('Consumable request report', 'consumables') : __('Consumable requests history', 'consumables') }}
        </h3>
        {% if rows is not empty %}
            <span class="badge bg-secondary-lt ms-2">{{ rows|length }}</span>
        {% endif %}
    </div>
    {% if rows is not empty %}
        <div class="table-responsive">
            <table class="table table-hover table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ __('Requester') }}</th>
                        <th>{{ __('Approver') }}</th>
                        <th>{{ __('Number of used consumables') }}</th>
                        <th>{{ __('Request date') }}</th>
                        <th>{{ __('Give to') }}</th>
                        <th>{{ __('Status') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.requester }}</td>
                            <td>{{ row.approver }}</td>
                            <td>{{ row.number }}</td>
                            <td class="text-secondary">{{ row.date }}</td>
                            <td>{{ row.give_link|raw }}</td>
                            <td>{{ consumables.statusBadge(row.status_value, row.status) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="card-body">
            <div class="text-secondary">{{ __('No results found') }}</div>
        </div>
    {% endif %}
</div>
