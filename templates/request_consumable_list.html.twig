<div class="center">
    {% if rows is not empty %}
        <table class="tab_cadre_fixe">
            <tr>
                <th colspan="6">{{ __('Consumable request report', 'consumables') }}</th>
            </tr>
            <tr>
                <th>{{ __('Requester') }}</th>
                <th>{{ __('Approver') }}</th>
                <th>{{ __('Number of used consumables') }}</th>
                <th>{{ __('Request date') }}</th>
                <th>{{ __('Give to') }}</th>
                <th>{{ __('Status') }}</th>
            </tr>
            {% for row in rows %}
                <tr class="tab_bg_1">
                    <td>{{ row.requester }}</td>
                    <td>{{ row.approver }}</td>
                    <td>{{ row.number }}</td>
                    <td>{{ row.date }}</td>
                    <td>{{ row.give_link|raw }}</td>
                    <td>
                        <div style="background-color:{{ row.status_color }};">{{ row.status }}</div>
                    </td>
                </tr>
            {% endfor %}
        </table>
    {% else %}
        <table class="tab_cadre_fixe">
            <tr>
                <th colspan="6">{{ __('Consumable requests history', 'consumables') }}</th>
            </tr>
            <tr>
                <td class="center">{{ __('No results found') }}</td>
            </tr>
        </table>
    {% endif %}
</div>
