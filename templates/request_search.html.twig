{# Request search of a user or group tab (Request::showForUserOrGroup()). The results are
   reloaded into #consumables_searchConsumables by consumables_searchConsumables(). #}
<form name="form" method="post" action="" id="consumables_formSearchConsumables" data-root-doc="{{ webdir }}"
      class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-search me-2"></i>{{ __('Consumables request search', 'consumables') }}
        </h3>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label">{{ __('Begin date') }}</label>
                {{ begin_date_field|raw }}
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label">{{ __('End date') }}</label>
                {{ end_date_field|raw }}
            </div>
            <div class="col-12 col-md-4">
                {{ search_button|raw }}{{ hidden_requester|raw }}
            </div>
        </div>
    </div>
</form>

<div id="consumables_searchConsumables">{{ results|raw }}</div>
<div id="dialog-confirm"></div>
