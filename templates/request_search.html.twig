<form name="form" method="post" action="" id="consumables_formSearchConsumables" data-root-doc="{{ webdir }}">
    <div class="center">
        <table class="tab_cadre_fixe">
            <tr>
                <th colspan="6">{{ __('Consumables request search', 'consumables') }}</th>
            </tr>
            <tr class="tab_bg_1">
                <td>{{ __('Begin date') }}</td>
                <td>{{ begin_date_field|raw }}</td>
                <td>{{ __('End date') }}</td>
                <td>{{ end_date_field|raw }}</td>
                <td>{{ search_button|raw }}{{ hidden_requester|raw }}</td>
            </tr>
        </table>
    </div>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>

<div class="center" id="consumables_searchConsumables">{{ results|raw }}</div>
<div id="dialog-confirm"></div>
