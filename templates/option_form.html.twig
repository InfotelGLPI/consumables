<div class="center">
    <form action="{{ form_url }}" method="post">
        <table class="tab_cadre_fixe">
            <tr>
                <th colspan="3">{{ title }}</th>
            </tr>
            <tr class="tab_bg_1">
                <td>{{ __('Maximum number allowed for request', 'consumables') }} </td>
                <td>{{ max_cart_dropdown|raw }} </td>
                {% if can_create %}
                    <td class="center">{{ define_button|raw }}</td>
                {% endif %}
            </tr>
            <input type="hidden" name="consumableitems_id" value="{{ consumableitems_id }}">
            <input type="hidden" name="id" value="{{ id }}">
        </table>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>

    <form action="{{ form_url }}" method="post">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_1">
                <th colspan="2">{{ __('Allowed groups for request', 'consumables') }} </th>
            </tr>
            {% if groups_rows is not empty %}
                {% for group in groups_rows %}
                    <tr class="tab_bg_1 center">
                        <td>{{ group.name }}</td>
                        <td>{{ group.delete_form|raw }} </td>
                    </tr>
                {% endfor %}
            {% else %}
                <tr class="tab_bg_1">
                    <td colspan="2">{{ __('None') }}</td>
                </tr>
            {% endif %}
            <input type="hidden" name="consumableitems_id" value="{{ consumableitems_id }}">
            <input type="hidden" name="id" value="{{ id }}">
        </table>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>
</div>
