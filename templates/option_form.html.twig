{# Request options of a consumable item (Option::listOptionsForConsumable()): the maximum
   quantity per request, then the groups allowed to request it. Each group row carries its own
   delete form (Html::getSimpleForm()), so the list is not wrapped in another form. #}
<div class="card mb-3">
    <div class="card-header">
        <h3 class="card-title">
            <i class="ti ti-adjustments me-2"></i>{{ title }}
        </h3>
    </div>
    <div class="card-body">
        <form action="{{ form_url }}" method="post">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-6">
                    <label class="form-label">{{ __('Maximum number allowed for request', 'consumables') }}</label>
                    {{ max_cart_dropdown|raw }}
                </div>
                {% if can_create %}
                    <div class="col-12 col-md-6">
                        {{ define_button|raw }}
                    </div>
                {% endif %}
            </div>
            <input type="hidden" name="consumableitems_id" value="{{ consumableitems_id }}">
            <input type="hidden" name="id" value="{{ id }}">
        </form>

        <div class="hr-text">
            <i class="ti ti-users-group"></i>
            <span>{{ __('Allowed groups for request', 'consumables') }}</span>
        </div>
        {% if groups_rows is not empty %}
            <div class="list-group">
                {% for group in groups_rows %}
                    <div class="list-group-item d-flex align-items-center">
                        <i class="ti ti-users me-2 text-secondary"></i>
                        <span class="flex-grow-1">{{ group.name }}</span>
                        {{ group.delete_form|raw }}
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-secondary">{{ __('None') }}</div>
        {% endif %}
    </div>
</div>
