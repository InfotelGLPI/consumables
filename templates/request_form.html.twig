{# Consumable request wizard (Request::showConsumableRequest()). The cart rows are built by
   consumables_addToCart() in public/js/consumables.js, which also toggles the cart display;
   #loadAvailableConsumables, #loadAvailableConsumablesNumber and #seeConsumablesInfos are
   filled through ajax/request.php. #}
<div class="container-lg my-3">
    <form name="wizard_form" id="consumables_wizardForm" method="post" data-root-doc="{{ webdir }}">
        <div class="card mb-3">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-shopping-cart-plus me-2"></i>{{ __('Consumable request', 'consumables') }}
                </h3>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-lg-8">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">{{ __('Requester') }}</label>
                                <div class="form-control-plaintext">
                                    <i class="ti ti-user me-1 text-secondary"></i>{{ requester_name }}
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label required">{{ _n('Consumable type', 'Consumable types', 1) }}</label>
                                <div>{{ type_dropdown|raw }}</div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label required">{{ _n('Consumable', 'Consumables', 1) }}</label>
                                <div id="loadAvailableConsumables"></div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label required">{{ __('Number', 'consumables') }}</label>
                                <div id="loadAvailableConsumablesNumber">{{ number_cell|raw }}</div>
                            </div>
                            {% if give_to is not empty %}
                                <div class="col-12">
                                    <label class="form-label">{{ __('Give to') }}</label>
                                    <div>{{ give_to|raw }}</div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div id="seeConsumablesInfos" class="text-center"></div>
                    </div>
                </div>
            </div>
            {% if can_add %}
                <div class="card-footer text-end">
                    <button type="button" class="btn btn-success" name="addToCart"
                            onclick="consumables_addToCart('addToCart','consumables_wizardForm', 'consumables_cart');">
                        <i class="ti ti-plus me-1"></i>{{ __('Add to cart', 'consumables') }}
                    </button>
                </div>
            {% endif %}
        </div>

        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-shopping-cart me-2"></i>{{ __('Cart', 'consumables') }}
                </h3>
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter card-table" id="consumables_cart" style="display:none">
                    <tr>
                        <th>{{ __('Requester') }}</th>
                        <th>{{ _n('Consumable type', 'Consumable types', 1) }}</th>
                        <th>{{ _n('Consumable', 'Consumables', 1) }}</th>
                        <th>{{ __('Number', 'consumables') }}</th>
                        <th>{{ __('Give to') }}</th>
                        <th class="w-1"></th>
                    </tr>
                </table>
            </div>
            {% if can_add %}
                <div class="card-footer d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" name="previous"
                            onclick="consumables_cancel('{{ webdir|e('js') }}/front/wizard.php');">
                        <i class="ti ti-arrow-left me-1"></i>{{ _x('button', 'Cancel') }}
                    </button>
                    <button type="button" class="btn btn-primary" name="addConsumables"
                            onclick="consumables_addConsumables('addConsumables','consumables_wizardForm');">
                        <i class="ti ti-send me-1"></i>{{ _x('button', 'Post') }}
                    </button>
                </div>
            {% endif %}
        </div>
        <div id="dialog-confirm"></div>
    </form>
</div>
