<form action="{{ form_url }}" method="post">
    <table class="tab_cadre_fixe" cellpadding="5">
        <tr class="tab_bg_1 center">
            <th>{{ __('Add a group for request', 'consumables') }}</th>
            <th>&nbsp;</th>
        </tr>
        <tr class="tab_bg_1 center">
            <td>{{ group_dropdown|raw }}</td>
            <td>
                <input type="hidden" name="consumableitems_id" value="{{ consumableitems_id }}">
                <input type="hidden" name="id" value="{{ id }}">
                {{ add_button|raw }}
            </td>
        </tr>
    </table>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
